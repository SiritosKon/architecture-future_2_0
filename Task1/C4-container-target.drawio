<mxfile host="drawio" type="device"><diagram id="C4-Container-Target" name="C4-Container-Target"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="C4 Container. Целевая архитектура «Будущее 2.0» через год (Data Mesh)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="-30" width="1400" height="30" as="geometry"/></mxCell><mxCell id="p_emp" value="&lt;b&gt;Сотрудники доменов&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;операторы клиник, финтех, ИИ, аналитики&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;" vertex="1" parent="1"><mxGeometry x="380" y="20" width="200" height="120" as="geometry"/></mxCell><mxCell id="p_mgmt" value="&lt;b&gt;Руководство&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;головной офис&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontSize=11;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;" vertex="1" parent="1"><mxGeometry x="1000" y="20" width="200" height="120" as="geometry"/></mxCell><mxCell id="boundary" value="&lt;b&gt;Будущее 2.0 — платформа данных&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Software System]&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#444444;fontColor=#444444;align=right;verticalAlign=bottom;spacingRight=12;spacingBottom=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="1640" height="780" as="geometry"/></mxCell><mxCell id="portal" value="&lt;b&gt;Портал самообслуживания&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Container: Web App]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;витрина данных, конструктор отчётов&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="230" width="300" height="90" as="geometry"/></mxCell><mxCell id="bi" value="&lt;b&gt;BI и семантический слой&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Container: BI, metrics layer]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;единые метрики, дашборды&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="950" y="230" width="300" height="90" as="geometry"/></mxCell><mxCell id="gov" value="&lt;b&gt;Федеративное управление&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Container: IAM, data contracts]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;глобальные политики, доступ, аудит&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="390" width="300" height="100" as="geometry"/></mxCell><mxCell id="platform" value="&lt;b&gt;Self-serve платформа данных&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Container: облачный Lakehouse, Kafka, Query Engine]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;хранит и отдаёт data products доменов, каталог&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="390" width="520" height="100" as="geometry"/></mxCell><mxCell id="d_fin" value="Домен Финтех" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#f2f7fc;strokeColor=#3C7FC0;fontColor=#1d4f80;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="560" width="300" height="320" as="geometry"/></mxCell><mxCell id="fin_dp" value="&lt;b&gt;Data product: финтех&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Container: витрина домена]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;счета, кредиты, платежи&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#2e9e6b;strokeColor=#1f7a51;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="105" y="610" width="250" height="90" as="geometry"/></mxCell><mxCell id="fin_svc" value="&lt;b&gt;Финтех-сервисы&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Container: Go, Java]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;бизнес-логика финтеха&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="105" y="760" width="250" height="90" as="geometry"/></mxCell><mxCell id="d_cli" value="Домен Клиника" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#f2f7fc;strokeColor=#3C7FC0;fontColor=#1d4f80;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="410" y="560" width="560" height="320" as="geometry"/></mxCell><mxCell id="cli_dp" value="&lt;b&gt;Data product: клиника&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Container: витрина домена]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;визиты, счета, без медданных&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#2e9e6b;strokeColor=#1f7a51;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="435" y="610" width="230" height="90" as="geometry"/></mxCell><mxCell id="legacy" value="&lt;b&gt;Легаси DWH и PowerBuilder&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Container: SQL Server 2008]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;работает до миграции&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#9e9e9e;strokeColor=#757575;dashed=1;dashPattern=6 4;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="725" y="610" width="225" height="90" as="geometry"/></mxCell><mxCell id="cli_svc" value="&lt;b&gt;Сервисы клиник&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Container: операционная система]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;визиты, расписание&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="435" y="760" width="230" height="90" as="geometry"/></mxCell><mxCell id="med" value="&lt;b&gt;Медицинские данные&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Container: изолированное хранилище]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;только для ИИ, вне аналитики&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#438DD5;strokeColor=#c0392b;strokeWidth=3;dashed=1;dashPattern=6 4;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="725" y="760" width="225" height="90" as="geometry"/></mxCell><mxCell id="d_ai" value="Домен ИИ" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#f2f7fc;strokeColor=#3C7FC0;fontColor=#1d4f80;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="560" width="300" height="320" as="geometry"/></mxCell><mxCell id="ai_dp" value="&lt;b&gt;Data product: ИИ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Container: витрина домена]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;обезличенные метрики моделей&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#2e9e6b;strokeColor=#1f7a51;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1025" y="610" width="250" height="90" as="geometry"/></mxCell><mxCell id="ai_svc" value="&lt;b&gt;ИИ-сервисы&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Container: Python]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;модели для медданных&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1025" y="760" width="250" height="90" as="geometry"/></mxCell><mxCell id="d_part" value="Партнёры (future)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=#fafcfe;strokeColor=#9ab7d6;fontColor=#5f7f9f;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1330" y="560" width="320" height="320" as="geometry"/></mxCell><mxCell id="part_dp" value="&lt;b&gt;Data product: партнёр&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Container: витрина домена]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;фарма, электроника&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#a8dcc3;strokeColor=#1f7a51;dashed=1;dashPattern=6 4;fontColor=#14513a;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1365" y="610" width="250" height="90" as="geometry"/></mxCell><mxCell id="part_svc" value="&lt;b&gt;Сервисы партнёров&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Container: future]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#a9cdf2;strokeColor=#3C7FC0;dashed=1;dashPattern=6 4;fontColor=#0b3d6e;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1365" y="760" width="250" height="90" as="geometry"/></mxCell><mxCell id="pay" value="&lt;b&gt;Платёжные системы / ЦБ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[External System]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="105" y="1010" width="250" height="80" as="geometry"/></mxCell><mxCell id="e1" value="строят отчёты [HTTPS]" style="html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p_emp" target="portal"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="смотрят дашборды [HTTPS]" style="html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p_mgmt" target="bi"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="запросы к data products" style="html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0.65;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="portal" target="platform"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="проверка прав" style="html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="portal" target="gov"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="SQL-запросы" style="html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0.35;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bi" target="platform"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="глобальные политики" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gov" target="platform"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="публикует" style="html=1;endArrow=block;endFill=1;strokeColor=#1f7a51;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.05;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="fin_dp" target="platform"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="публикует" style="html=1;endArrow=block;endFill=1;strokeColor=#1f7a51;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="cli_dp" target="platform"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="публикует" style="html=1;endArrow=block;endFill=1;strokeColor=#1f7a51;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ai_dp" target="platform"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="публикует" style="html=1;endArrow=block;endFill=1;strokeColor=#1f7a51;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.6;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="part_dp" target="platform"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="события [Kafka]" style="html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="fin_svc" target="fin_dp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="события, CDC [Kafka]" style="html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="cli_svc" target="cli_dp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="метрики моделей" style="html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ai_svc" target="ai_dp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="события" style="html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="part_svc" target="part_dp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="CDC" style="html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="legacy" target="cli_dp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="медкарты" style="html=1;endArrow=block;endFill=1;strokeColor=#c0392b;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cli_svc" target="med"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="медданные" style="html=1;endArrow=block;endFill=1;strokeColor=#c0392b;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="med" target="ai_svc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="платежи" style="html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fin_svc" target="pay"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="notes" value="&lt;b&gt;Бизнес-сценарии&lt;/b&gt;&lt;br&gt;• Быстрая отчётность — портал и BI работают поверх self-serve платформы с готовыми data products.&lt;br&gt;• Независимое развитие финтеха и ИИ — у каждого свой домен: сервисы и собственный data product, релизы без общего DWH.&lt;br&gt;• Масштабирование для новых бизнесов — домен партнёра подключается так же: свой data product, публикация на платформу.&lt;br&gt;• Качество мед/фин сервисов — медданные изолированы внутри домена клиники, доступ и контракты задаёт федеративное управление." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;rounded=1;fillColor=#fff8e1;strokeColor=#e8a202;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="420" y="1000" width="1230" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>