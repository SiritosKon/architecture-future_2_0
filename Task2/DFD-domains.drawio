<mxfile host="drawio" type="device"><diagram id="DFD-Domains" name="DFD-Domains"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Data Flow Diagram «Будущее 2.0». Потоки данных между доменами" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="30" as="geometry"/></mxCell><mxCell id="cli" value="&lt;b&gt;Домен Клиника&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;визиты, расписание, счета&lt;/span&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="100" width="230" height="70" as="geometry"/></mxCell><mxCell id="med" value="&lt;b&gt;Медицинские данные&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;только для ИИ, вне аналитики&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;strokeWidth=3;dashed=1;dashPattern=6 4;fontColor=#922b21;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="210" width="230" height="50" as="geometry"/></mxCell><mxCell id="ai" value="&lt;b&gt;Домен ИИ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;модели для медданных&lt;/span&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="300" width="230" height="70" as="geometry"/></mxCell><mxCell id="fin" value="&lt;b&gt;Домен Финтех&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;счета, кредиты, платежи&lt;/span&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="410" width="230" height="70" as="geometry"/></mxCell><mxCell id="corp" value="&lt;b&gt;Домен Корпоративные функции&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;HR, инвентаризация, финансы&lt;/span&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="520" width="230" height="70" as="geometry"/></mxCell><mxCell id="part" value="&lt;b&gt;Домен партнёра&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;фарма, электроника (future)&lt;/span&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#a9cdf2;strokeColor=#3C7FC0;dashed=1;dashPattern=6 4;fontColor=#0b3d6e;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="630" width="230" height="70" as="geometry"/></mxCell><mxCell id="platform" value="&lt;b&gt;Self-serve платформа данных&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;хранит и отдаёт&lt;br&gt;data products доменов&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#2e9e6b;strokeColor=#1f7a51;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="100" width="220" height="600" as="geometry"/></mxCell><mxCell id="portal" value="&lt;b&gt;Портал самообслуживания и BI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;конструктор отчётов, дашборды&lt;/span&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1070" y="340" width="220" height="110" as="geometry"/></mxCell><mxCell id="e_pat" value="&lt;b&gt;Пациенты / клиенты&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="180" height="60" as="geometry"/></mxCell><mxCell id="e_pay" value="&lt;b&gt;Платёжные системы / ЦБ&lt;/b&gt;" style="rounded=0;white